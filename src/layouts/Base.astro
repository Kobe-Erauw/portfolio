---
/**
 * Layout for every page, and the ONLY place where <head> (title, description,
 * canonical URL, social previews, structured data) is written.
 */
import 'bootstrap/dist/css/bootstrap.min.css'
import 'bootstrap-icons/font/bootstrap-icons.css'
import '../styles/retro.css'
import { AUTHOR, LINKEDIN_URL, SITE_NAME, SITE_URL } from '../lib/site'

interface Props {
  title: string
  description: string
  /** Path of this page, e.g. "/project/portfolio". Leave it out for pages Google must not index. */
  path?: string
  /** Preview image for social media */
  image?: string
  /** Wide preview (screenshots) or small square one next to the text (profile photo) */
  imageStyle?: 'large' | 'small'
  /** Structured data (JSON-LD) for this page */
  schema?: object[]
}

const { title, description, path, image, imageStyle = 'large', schema = [] } = Astro.props
const url = path ? new URL(path, SITE_URL).href : undefined
// "<" escaped so text in the data can never close the <script> tag
const toJsonLd = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    {url ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image && imageStyle === 'large' ? 'summary_large_image' : 'summary'}
    />

    {schema.map((data) => (
      <script type="application/ld+json" set:html={toJsonLd(data)} />
    ))}
  </head>
  <body class="d-flex flex-column min-vh-100">
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
          <a class="navbar-brand" href="/">
            Portfolio
          </a>
          <a
            href="/about"
            class:list={['nav-link ms-auto me-4', { active: path === '/about' }]}
            aria-current={path === '/about' ? 'page' : undefined}
          >
            About
          </a>
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link d-flex align-items-center gap-2"
          >
            <i class="bi bi-linkedin"></i>
            <span>LinkedIn</span>
          </a>
        </div>
      </nav>
    </header>

    <div class="flex-grow-1">
      <slot />
    </div>

    <footer class="footer mt-auto py-3 bg-light text-center">
      <div class="container d-flex align-items-center justify-content-center gap-3">
        <span class="text-muted">
          © {new Date().getFullYear()} {AUTHOR}
        </span>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted d-flex align-items-center gap-1"
        >
          <i class="bi bi-linkedin"></i>
          <span>LinkedIn</span>
        </a>
      </div>
    </footer>
  </body>
</html>
