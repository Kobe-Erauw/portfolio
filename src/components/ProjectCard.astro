---
import type { Project } from '../lib/github'

interface Props {
  project: Project
}

const { project } = Astro.props
const href = `/project/${project.name}`
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('nl-NL')
---

<div class="col">
  <div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
      <h3 class="card-title h5">
        <a href={href} class="text-reset">
          {project.name}
        </a>
      </h3>
      {project.language && <h6 class="card-subtitle mb-2 text-muted">{project.language}</h6>}

      {project.imageUrl && (
        <img
          src={project.imageUrl}
          alt={`Preview of ${project.displayName}`}
          width="400"
          height="200"
          loading="lazy"
          class="img-fluid mb-3 rounded d-block mx-auto"
          style="max-height: 200px; object-fit: contain"
        />
      )}

      <p class="card-text flex-grow-1">{project.description}</p>
      <div class="mt-3 d-flex justify-content-between align-items-center">
        <a href={href} class="btn btn-primary btn-sm">
          View Details
        </a>
        <a
          href={project.githubUrl}
          target="_blank"
          class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"
          title="View on GitHub"
        >
          <i class="bi bi-github"></i>
          <span>GitHub</span>
          <span class="vr mx-1"></span>
          <span>
            <i class="bi bi-star-fill text-warning"></i> {project.stars}
          </span>
        </a>
      </div>
    </div>
    <div class="card-footer text-muted small d-flex justify-content-between align-items-center">
      <span
        class="d-flex align-items-center tooltip-trigger"
        data-bs-toggle="tooltip"
        data-bs-title="Created on"
        tabindex="0"
      >
        <i class="bi bi-calendar-plus me-1"></i>
        {formatDate(project.createdAt)}
      </span>
      <span
        class="d-flex align-items-center tooltip-trigger"
        data-bs-toggle="tooltip"
        data-bs-title="Last commit on"
        tabindex="0"
      >
        <i class="bi bi-clock-history me-1"></i>
        {formatDate(project.pushedAt)}
      </span>
    </div>
  </div>
</div>

<script>
  import { Tooltip } from 'bootstrap'

  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => new Tooltip(el))
</script>

<style>
  .card {
    transition: transform 0.2s;
  }

  .card:hover {
    transform: translateY(-5px);
  }

  .tooltip-trigger {
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: help;
    transition: color 0.2s;
  }

  .tooltip-trigger:hover,
  .tooltip-trigger:focus {
    color: var(--retro-accent, #00ff00);
  }
</style>
